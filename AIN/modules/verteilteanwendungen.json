  "learning_outcomes": [
    {
      "category": "Wissen",
      "items": [
        "die wesentlichen technologischen Grundlagen verteilter Medienanwendungen benennen.",
        "die Teilbausteine verteilter Anwendungen einordnen."
      ]
    },
    {
      "category": "Verständnis",
      "items": [
        "nebenläufig programmieren.",
        "Programme implementieren, die mit Hilfe des TCP/IP-Stacks miteinander kommunizieren."
      ]
    },
    {
      "category": "Anwendung",
      "items": [
        "Medieninhalt in Web-Anwendungen integrieren.",
        "eine Web-basierte Anwendung inklusive Datenbankanbindung implementieren."
      ]
    },
    {
      "category": "Analyse",
      "items": [
        "bestehende Softwarearchitekturen bezüglich der relevanten Aspekte untersuchen."
      ]
    },
    {
      "category": "Evaluation/Bewertung",
      "items": [
        "Softwarearchitekturen für verteilte Medienanwendungen bzgl. ihres Einsatzes in bestimmten Anwendungsfeldern einordnen und bewerten."
      ]
    }
  ],
  "individual_component_content": [
    {
      "items": [
        "nebenläufige Programmierung",
        "elementare Netzwerkkommunikation zwischen Computerprogrammen (TCP/IP-Stack)",
        "Services, Anwendungsprotokolle",
        "Medieninhalte und Medienformate",
        "Web-Anwendungen, Medieninhalte in Web-Anwendungen",
        "Datenbankanbindung",
        "Benutzerverwaltung in verteilten Anwendungen",
        "REST-APIs",
        "AJAX, Single-Page-Applications Anhand von Übungsaufgaben werden die in der Vorlesung behandelten Methoden und Verfahren geübt."
      ]
    }
  ],
  "teaching_methods": [
