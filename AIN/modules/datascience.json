  "learning_outcomes": [
    {
      "category": "Verständnis",
      "items": [
        "die Definition von ‚Data Science‘ erläutern",
        "die Einzelschritte der Datenanalyse erklären"
      ]
    },
    {
      "category": "Anwendung",
      "items": [
        "Daten mit Hilfe deskriptiver Statistik untersuchen",
        "Maßnahmen ergreifen, um Daten zu bereinigen",
        "Daten auf geeignete Weise visualisieren"
      ]
    },
    {
      "category": "Analyse",
      "items": [
        "systematisch Methoden nutzen, um ein tiefes Verständnis für Daten zu entwickeln",
        "mit Data Exploration arbeiten, um unbekannte Daten zu untersuchen",
        "große Datenmengen geeignet zusammenfassen und veranschaulichen"
      ]
    }
  ],
  "individual_component_content": [
    {
      "items": [
        "Data Frames für tabellarische Daten",
        "Indexe auf Daten",
        "Daten in mehrdimensionalen Arrays",
        "Der Umgang mit fehlenden Daten",
        "Ausreißer",
        "Daten verknüpfen, kombinieren und umformen",
        "Daten aggregieren und gruppieren",
        "Zeitreihen und Querschnittsdaten",
        "Kategorische Daten",
        "Einfache Modellbildung und Vorhersagen",
        "Einsatz von Künstlicher Intelligenz Praktische Übungen mit Python und den Bibliotheken NumPy, Pandas und Seaborn. Einsatz von Künstlicher Intelligenz. Anwendungsbeispiele anhand von praxisorientierten Datensätzen."
      ]
    }
  ],
  "teaching_methods": [
    {
      "items": [
        "Vorlesung",
        "Praktikum"
      ]
    }
  ],
